# Copy this file to .env and edit values as needed.
# Example:
# DATASET_NAME=my_dataset
# WEB_PORT=8092

# Name of the dataset (optional).
DATASET_NAME=

# Host port to expose the SAM2 web UI (default 8092)
WEB_PORT=8092

# Optionally set the host UID/GID to run containers with matching ownership.
# Default is 1000:1000 which matches the container user created in the image.
HOST_UID=1000
HOST_GID=1000

# HESTIA backend credentials (for vm_comms worker poller and UI)
HESTIA_API_KEY=
HESTIA_API_URL=https://api.textailes.athenarc.gr

# Host mount points for worker_poller (REQUIRED — worker_poller runs on host, not in container)
# Set these to the actual host paths where SAM2 input/output dirs live
IN_MNT=/opt/samplify_sugar/SAM2/data/input
OUT=/opt/samplify_sugar/SAM2/data/output

# Reconstruction output roots (where the worker harvests the final mesh).
# Defaults derive from the repo layout; override only if you relocate outputs.
# PGSR_RESULTS_ROOT=/opt/samplify_sugar/PGSR/outputs
# Fast-PGSR (FastGS backend) writes to its own isolated tree:
# FASTPGSR_RESULTS_ROOT=/opt/samplify_sugar/FASTPGSR/outputs

# Force this worker to run a fixed reconstruction model for every job,
# overriding the job field and any .model file (sugar|pgsr|fastpgsr).
# Leave unset for normal per-job behaviour.
# FORCE_MODEL=fastpgsr

# Demo dataset_name SUFFIXES (comma-separated): jobs whose dataset_name ends
# with one of these skip real SAM2 and reconstruction entirely — canned
# previews from DEMO_FIXTURES_DIR/<suffix-without-leading-_>, then an instant
# "done". Suffix match, not exact: nefele_ui mints a fresh random-prefixed
# dataset_name per demo session (e.g. "u2a6f4bf6_dress_demo", then
# "uffb726bf_dress_demo"), so exact matching silently stops working on the
# next session. Matches job.dataset_name, NOT scan_id (scan_id is often
# reused across several real datasets, so matching on it would fast-path
# real users' jobs too).
# DEMO_DATASET_SUFFIXES=_dress_demo
# DEMO_FIXTURES_DIR=/opt/samplify_sugar/SAM2/app/demo_fixtures
